# Copy to .env for LOCAL development. Production config on EC2 comes from
# deploy/env.production.example (installed at /opt/portfolio-api/.env).

APP_ENV=development
PORT=8080

# Origins allowed to call this API cross-origin (comma-separated). Only needed
# locally, where the frontend (:8765) and API (:8080) are different origins.
ALLOWED_ORIGINS=http://localhost:8765

# Gmail SMTP relay. Use a DEDICATED Gmail account created just for sending
# this app's mail (e.g. yourname.portfolio.relay@gmail.com) — NOT your
# personal/primary account. If this App Password ever leaks, the blast
# radius is one disposable relay account, not your real inbox.
#
# Setup: create the throwaway account -> enable 2-Step Verification on it ->
# generate an App Password at https://myaccount.google.com/apppasswords ->
# set that account to auto-forward incoming mail to your real address so you
# don't have to monitor a second inbox (Gmail Settings -> Forwarding).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourname.portfolio.relay@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=yourname.portfolio.relay@gmail.com

# Where contact-form submissions are delivered — your real inbox.
CONTACT_TO_EMAIL=sumaiya.rahim234@gmail.com

# Contact form throughput cap, per client IP.
RATE_LIMIT_PER_MINUTE=5
