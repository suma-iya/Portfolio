# Copy to deploy/deploy.env (git-ignored) and fill in. Read by deploy/deploy.sh.

# Your EC2 Elastic IP (or your domain, once DNS points at the instance).
EC2_HOST=203.0.113.10
EC2_USER=ubuntu
# The .pem key pair you downloaded when launching the instance.
SSH_KEY=~/.ssh/portfolio-key.pem

# Optional. Leave both empty to serve the site over plain HTTP on the IP.
# Set them to get a free Let's Encrypt HTTPS certificate automatically.
# DNS for every name must already point at EC2_HOST.
# Several names: DOMAINS="example.com www.example.com"
DOMAINS=
LETSENCRYPT_EMAIL=
