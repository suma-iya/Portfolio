# Production config for the Go backend on EC2.
# Lives at /opt/portfolio-api/.env (root-only). Edit with:
#   sudo nano /opt/portfolio-api/.env && sudo systemctl restart portfolio-api
#
# NOTE: systemd reads this file — keep comments on their own lines, and don't
# wrap values in quotes.

APP_ENV=production

# Loopback only: Nginx is the public entry point, port 8080 stays private.
HOST=127.0.0.1
PORT=8080
TRUSTED_PROXIES=127.0.0.1

# Gmail SMTP. SMTP_PASSWORD is a 16-character Google *App Password*
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification on),
# NOT your normal Gmail password. Type it without spaces.
# Safer option: use a separate Gmail account just for sending, so a leaked
# App Password can't expose your main inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Defaults to SMTP_USERNAME when empty. Gmail rewrites any other address anyway.
SMTP_FROM=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=sumaiya.rahim234@gmail.com

# Contact-form submissions allowed per visitor IP per minute.
RATE_LIMIT_PER_MINUTE=5
